# UniTicket Frontend Environment Variables
# Trong production trên Vercel, đặt biến này trỏ đến backend Render:
# VITE_API_BASE_URL=https://uniticket-cjci.onrender.com

# Trong local development:
VITE_API_BASE_URL=http://localhost:4000

# Supabase Cloud Database Configuration (Tuỳ chọn cho lưu trữ vé On-chain & Realtime)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
